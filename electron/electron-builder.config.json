{
  "appId": "com.philippe.realornot",
  "productName": "RealOrNot",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*"
  ],
  "publish": null,
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": "nsis",
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "category": "your.app.category.type",
    "target": "dmg"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/icons",
    "category": "Utility",
    "maintainer": "Philippe <turlututupointu3@gmail.com>"
  }
}